# Names only. Real values live in /etc/visionex-isp/isp.env (mode 0600, root:root),
# outside any Git-controlled directory. Never commit a filled-in copy.

# --- environment identity (refuses to start if it disagrees with the database) ---
ISP_ENV=development            # development | staging | production

# --- HTTP ---
ISP_HOST=127.0.0.1             # bind loopback; the gateway proxies to it
ISP_PORT=8443
ISP_PUBLIC_ORIGIN=https://isp-admin.example.invalid
ISP_TRUST_PROXY=true

# --- database (dedicated; never the superuser, never the VisionEX Supabase) ---
DATABASE_URL=
DATABASE_SSL=false             # true when the database is not on a private socket

# --- secrets ---
ISP_ENCRYPTION_KEY=            # base64, 32 bytes: encrypts TOTP seeds at rest
ISP_SESSION_PEPPER=            # base64, 32 bytes

# --- PI / Proradius portal ---
PI_BASE_URL=                   # the PI portal base URL (reachable via the private tunnel)
PI_USERNAME=                   # dedicated read-only service account
PI_PASSWORD=
PI_TOTP_SECRET=                # only if that account has 2FA
PI_ACTIONS_FILE=               # optional path to captured action templates (see docs/RADIUS.md)

# --- WhatsApp admin channel ---
WA_GATEWAY_HMAC_SECRET=        # shared with the public webhook that forwards admin traffic
WA_DIRECT_WEBHOOK=false        # true only if Meta calls this service directly
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# --- dangerous capabilities: off until tested on a safe account ---
ENABLE_RADIUS_WRITE=false
ENABLE_WHATSAPP_WRITE=false
ENABLE_CUSTOMER_SUSPENSION=false
ENABLE_CUSTOMER_ACTIVATION=false
ENABLE_CUSTOMER_TERMINATION=false

REQUIRE_MFA=true
